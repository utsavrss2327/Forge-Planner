# Supabase project settings. Use the public anon key; never expose a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Must match the URL you open in your browser and Supabase's allowed redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth client ID/secret belong in Supabase Auth > Providers > Google,
# not in NEXT_PUBLIC variables or this application's browser code.
# Server-only credentials
YOUTUBE_API_KEY=
OPENAI_API_KEY=
# Explicit local-only demonstration with sample data; no real authentication.
FORGE_DEMO_MODE=false
